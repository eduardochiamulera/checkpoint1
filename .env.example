# ============================================================
# Arquivo de exemplo de variaveis de ambiente
# Copie para .env e preencha com valores reais.
# NUNCA faca commit do arquivo .env com segredos reais!
# ============================================================

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# --- MySQL ---
MYSQL_PORT=3306
MYSQL_DATABASE=cursos
MYSQL_USER=cursos_app
MYSQL_PASSWORD=changeme_strong_password
MYSQL_ROOT_PASSWORD=changeme_root_password

# --- JWT ---
# Gere uma chave forte com: openssl rand -base64 32
JWT_SECRET_KEY=changeme_super_secret_key_at_least_32_chars
JWT_ISSUER=CursosAPI
JWT_AUDIENCE=CursosUsers
JWT_EXPIRATION_MINUTES=60

# --- Payment Gateway ---
# Simulated | Stripe | PayPal
PAYMENT_GATEWAY_TYPE=Simulated
